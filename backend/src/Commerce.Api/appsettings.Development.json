{
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "UseUtcTimestamp": false,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Identity": {
    "SeedRoles": true,
    "BootstrapAdmin": false
  },
  "Smtp": {
