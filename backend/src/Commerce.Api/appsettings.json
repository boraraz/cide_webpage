{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "localhost",
  "Identity": {
    "SeedRoles": false,
    "BootstrapAdmin": false
  },
  "Auth": {
    "SessionDays": 14,
    "EmailVerificationHours": 24,
    "PasswordResetHours": 1,
    "SecurityEventRetentionDays": 180
  },
  "PublicUrls": {
    "StorefrontUrl": "http://localhost:5173"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ObjectStorage": {
    "Region": "us-east-1"
  },
  "Catalog": {
    "SeedSampleData": false,
    "MediaUploadPermitLimit": 30,
    "MediaUploadWindowMinutes": 60,
    "LowStockThreshold": 5
  },
  "Commerce": {
    "ShippingFee": 149,
    "FreeShippingThreshold": 2500,
    "PendingPaymentMinutes": 30,
    "MaxQuantityPerLine": 10,
    "CartLifetimeDays": 30,
    "OrderAccessDays": 30,
    "ConfirmationSessionHours": 2
  }
}
