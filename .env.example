# Local development configuration.
#   cp .env.example .env
# .env is git-ignored. These values are development-only placeholders; change them freely and
# never reuse them in any shared or production environment.
#
# Who reads this file:
#   - docker compose (PostgreSQL, object storage)
#   - scripts/setup-api-secrets.sh, which copies the API's settings into `dotnet user-secrets`
# The React apps do NOT read this file. They use apps/*/.env.local (public VITE_ values only).

# Application environment for the API (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development

# Local URLs
API_URL=http://localhost:5080
STOREFRONT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# PostgreSQL (also used for DBeaver: host localhost, port POSTGRES_PORT)
POSTGRES_DB=sportswear_db
POSTGRES_USER=sportswear_dev
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_PORT=5432

# S3-compatible object storage (RustFS locally; any S3 provider in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sportswear-media
S3_ACCESS_KEY=sportswear-dev
S3_SECRET_KEY=change-me-local-dev-only
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
